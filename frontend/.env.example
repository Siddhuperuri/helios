# ---------------------------------------------------------------------------------------
# Helios frontend
# ---------------------------------------------------------------------------------------
# Nothing secret belongs in this file. Every NEXT_PUBLIC_ variable is compiled into the
# JavaScript bundle and is readable by anyone who opens the site. Backend secrets — the
# JWT signing key, OAuth client secrets, the email provider key — live in the backend's
# environment and must never appear here.

# Where the API lives, from the browser's point of view.
#
# Leave this EMPTY. Empty means "same origin as this app": in development a Next.js rewrite
# proxies /api/* to the backend, and in production Nginx routes /api/* to the backend
# cluster. Same-origin is required for the refresh cookie to work, because SameSite=Lax
# withholds cookies from cross-site requests — and localhost:3000 → 127.0.0.1:8000 is
# cross-site.
#
# Set it to an absolute URL only for a deployment that genuinely splits the two origins.
# That also requires SOLAR_COOKIE_SAMESITE=none, SOLAR_COOKIE_SECURE=true and the frontend
# origin listed in SOLAR_CORS_ORIGINS on the backend.
NEXT_PUBLIC_API_BASE=

# Where the dev-server rewrite forwards /api/* to. Build-time only; never sent to the
# browser. Ignored when NEXT_PUBLIC_API_BASE is set.
SOLAR_BACKEND_ORIGIN=http://127.0.0.1:8000
