# =======================================================================================
# Helios — backend environment
# =======================================================================================
#
# Copy to .env.development, .env.test or .env.production and fill in. Real values are
# never committed: .gitignore excludes every .env file except this one.
#
# The project used to need no secrets at all, because every upstream data service it used
# was keyless and public. That is still true of the *data* services — Open-Meteo and
# Nominatim need no key — but accounts, sessions and transactional email do, so this file
# now exists. Nothing here belongs in the frontend's environment: every NEXT_PUBLIC_
# variable is compiled into the browser bundle and is readable by anyone who opens the
# site.
#
# The backend refuses to start with SOLAR_ENV=production while any of these still holds a
# development default. See Settings.production_problems() in backend/app/config.py — it
# names each problem and what it would cause, rather than failing with "invalid config".

# ---------------------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------------------
# development | test | production. Only `production` enables the fail-closed startup check.
SOLAR_ENV=development

# Public origin of the deployed site, used for OAuth callbacks, the links inside emails,
# the CORS allowlist and the OAuth redirect allowlist. Must be the origin a browser sees,
# scheme included.
PUBLIC_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------
# Points at PgBouncer in the deployed topology, not at PostgreSQL, so that connection count
# does not grow with replica count. Leave unset in development and the backend falls back
# to a SQLite file — convenient locally, rejected in production.
DATABASE_URL=postgresql+psycopg://helios:CHANGE-ME@pgbouncer:6432/helios
DB_USER=helios
DB_PASSWORD=CHANGE-ME

# Deliberately small: PgBouncer multiplexes, so a large per-process pool would defeat it.
SOLAR_DB_POOL_SIZE=5
SOLAR_DB_MAX_OVERFLOW=5

# ---------------------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------------------
# Shared cache, distributed rate limiting, refresh-token revocation, email tokens and OAuth
# state. Unset in development means an in-process stand-in, which is fine for one process
# and is rejected in production — with it, a client could evade a rate limit by being
# routed to another replica and an OAuth callback landing elsewhere would fail.
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=1gb

# ---------------------------------------------------------------------------------------
# Tokens
# ---------------------------------------------------------------------------------------
# At least 32 bytes of real randomness. Anyone holding this can mint valid access tokens
# for any account:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE-ME-generate-a-random-48-byte-value

JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=1

# Must be true anywhere the site is served over HTTPS. False sends the refresh cookie in
# the clear.
SOLAR_COOKIE_SECURE=false
SOLAR_COOKIE_SAMESITE=lax
# Set only when the app and the API are on sibling subdomains of one registrable domain.
# Never a public suffix.
# SOLAR_COOKIE_DOMAIN=.helios.example.com

# ---------------------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------------------
# console | memory | ses | sendgrid | postmark | resend
#
# `console` prints the message and delivers nothing — the development default, so a signup
# can be completed without configuring a provider. `memory` captures messages for tests.
# Both are rejected in production, because with either of them nobody can verify an address
# or reset a password.
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@helios.example.com
EMAIL_FROM_NAME=Helios
# SES only; it authenticates with the ambient AWS credential chain, so no API key is used.
EMAIL_PROVIDER_REGION=us-east-1

# ---------------------------------------------------------------------------------------
# OAuth
# ---------------------------------------------------------------------------------------
# Optional. With a pair unset, that provider simply is not offered: the frontend asks which
# providers are configured and renders a button only for those.
#
# Register these exact callback URLs with the provider — they are matched exactly, and a
# mismatch is the most common reason an OAuth setup fails:
#   ${PUBLIC_ORIGIN}/api/auth/oauth/google/callback
#   ${PUBLIC_ORIGIN}/api/auth/oauth/github/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Where the browser may be sent after a flow completes. An OAuth callback that redirects
# wherever a query parameter says is an open redirect arriving with a fresh session
# attached, so anything not on this list is replaced with PUBLIC_ORIGIN.
SOLAR_OAUTH_ALLOWED_REDIRECTS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------------------
# Exact origins. Never `*`: credentials are enabled, so a wildcard would hand any site a
# session — and is forbidden by the CORS specification besides.
SOLAR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# How many proxies of ours sit in front. X-Forwarded-For is a list a client can prepend to,
# so the trustworthy entry is counted from the right-hand end. 0 for a directly exposed
# backend; 1 behind the shipped Nginx. Setting it too high lets a client choose its own
# rate-limit identity with a header.
SOLAR_TRUSTED_PROXY_HOPS=0

# The general API budget, per client, shared across every replica via Redis.
SOLAR_RATE_LIMIT=60
SOLAR_RATE_WINDOW=60

# ---------------------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------------------
SOLAR_JSON_LOGS=false
SOLAR_LOG_LEVEL=INFO
# Identifies this replica in every log line and metric. Containers get it from the
# hostname automatically.
# SOLAR_INSTANCE_ID=backend1
SOLAR_RELEASE=dev

SOLAR_METRICS_ENABLED=true
SOLAR_METRICS_PATH=/api/metrics

# Error tracking. Nothing is sent without a DSN. Reports are scrubbed of credentials
# before transmission and carry the account id but never the address.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Tracing. Requires backend/requirements-tracing.txt to be installed; without those
# packages the module logs once and continues.
SOLAR_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=helios-backend

# How long a terminating replica may spend finishing in-flight work. Must be below the
# orchestrator's own kill timeout, or the graceful drain is pointless.
SOLAR_SHUTDOWN_GRACE_S=45

# ---------------------------------------------------------------------------------------
# Science and data (unchanged)
# ---------------------------------------------------------------------------------------
# Every setting below predates this work and behaves exactly as it did. Listed so the file
# is a complete picture of what the backend reads.
# SOLAR_CACHE_TTL=2592000
# SOLAR_MAX_EXPERIMENTS=200
# SOLAR_ESTIMATE_RETENTION_DAYS=365
# SOLAR_MIN_TRAIN_DAYS=60
# SOLAR_DEFAULT_TRAIN_DAYS=730
# SOLAR_SEED=20240617
